LABLINK_SERVICE_NAME=lablink-api
# development | production  (production refuses test auth, memory, and CORS *)
# LABLINK_ENV=production
# test | firebase  (default firebase; pytest selects test). Production must be firebase.
LABLINK_AUTH_MODE=firebase
# memory | firestore. Production must be firestore. Never use memory as a production fallback.
LABLINK_PERSISTENCE=firestore
FIREBASE_PROJECT_ID=your-firebase-project-id
# Absolute path on the server. Never commit this file or put it in the frontend or Docker image.
# GOOGLE_APPLICATION_CREDENTIALS=/secret/lablink-firebase.json
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Comma-separated extra browser origins. * is ignored. Production requires explicit https origins.
# LABLINK_CORS_ORIGINS=https://YOUR_HOSTING_DOMAIN
# Gemini is server-side only. Never put this key in Vite env, the frontend, or the image.
# GEMINI_API_KEY=your-gcp-api-key
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_EMBED_MODEL=gemini-embedding-001
